generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contacts {
  id         String   @id
  type       String
  value      String
  href       String?
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model daily_technologies {
  id         String   @id
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model experiences {
  id           String   @id
  role         String
  company      String
  period       String
  description  String[]
  technologies String[]
  current      Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

model projects {
  id           String   @id
  name         String   @unique
  description  String
  technologies String[]
  github       String?
  demo         String?
  academic     Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model skills {
  id         String   @id
  category   String
  name       String
  level      String
  created_at DateTime @default(now()) @db.Timestamp(6)
}
